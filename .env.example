# Copy this file to .env for local development. Never use the examples in production.
# The SESSION_SECRET and MCP_TOKEN_SECRET placeholders below are rejected by the API at
# startup, so replace both before running anything.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:4000
# Match apps/api/.env.example exactly, or set DATABASE_URL in this root file.
DATABASE_URL=postgresql://dockpilot:local-development-only@127.0.0.1:54329/dockpilot
SESSION_SECRET=replace-with-at-least-32-random-bytes-before-running
# MCP control layer. Set MCP_ENABLED=false to serve no MCP endpoint at all.
MCP_ENABLED=true
# The MCP token HMAC key. Generate it separately from SESSION_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Required in production whenever MCP_ENABLED is true.
MCP_TOKEN_SECRET=replace-with-a-unique-32-character-or-longer-secret
TRUSTED_PROXY=false
