# Set DATABASE_URL explicitly. Root workspace example includes local development settings.
DATABASE_URL=postgresql://dockpilot:local-development-only@127.0.0.1:54329/dockpilot
# Production requires a unique, cryptographically generated secret (32+ characters).
SESSION_SECRET=change-to-a-unique-32-character-or-longer-secret-before-deployment
# MCP control layer. Set MCP_ENABLED=false to serve no MCP endpoint at all.
MCP_ENABLED=true
# The MCP token HMAC key. Generate it separately from SESSION_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Required in production whenever MCP_ENABLED is true (32+ characters).
MCP_TOKEN_SECRET=change-to-an-independent-32-character-or-longer-secret-before-deployment
# Bind the public-facing API only if a reverse proxy or trusted load balancer protects it.
HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
TRUSTED_PROXY=false
