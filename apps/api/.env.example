# Set DATABASE_URL explicitly. Root workspace example includes local development settings.
DATABASE_URL=postgresql://dockpilot:local-development-only@127.0.0.1:54329/dockpilot
# Production requires a unique, cryptographically generated secret (32+ characters).
SESSION_SECRET=change-to-a-unique-32-character-or-longer-secret-before-deployment
# Bind the public-facing API only if a reverse proxy or trusted load balancer protects it.
HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
TRUSTED_PROXY=false
